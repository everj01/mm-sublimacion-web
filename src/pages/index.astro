<script>
  // Filtro de productos
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const items = document.querySelectorAll<HTMLElement>(".prod");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
      const f = chip.dataset.filtro;
      items.forEach((it) => {
        const show = f === "todos" || it.dataset.cat === f;
        it.classList.toggle("oculto", !show);
      });
    });
  });

  // Reveal al hacer scroll (marca <html> con .js para activar el modo animado)
  document.documentElement.classList.add("js");
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          obs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );
  document
    .querySelectorAll<HTMLElement>(".reveal")
    .forEach((el) => obs.observe(el));
</script>
