---
import "../styles/global.css";
import site from "../data/site.json";

const {
  marca,
  contacto,
  redes,
  categorias,
  productos,
  galeria,
  proceso,
  publicaciones,
  testimonios,
} = site;

const waText = encodeURIComponent(
  contacto.whatsappMensaje || "Hola, quiero un pedido personalizado",
);
const waLink = `https://wa.me/${contacto.whatsapp}?text=${waText}`;
const mailLink = `mailto:${contacto.correo}`;
const destacados = productos.filter((p) => p.destacado).slice(0, 3);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{marca.nombreCompleto} — {marca.lema}</title>
    <meta name="description" content={marca.frase} />
    <link rel="icon" type="image/png" href={marca.logo} />
    <meta property="og:title" content={marca.nombreCompleto} />
    <meta property="og:description" content={marca.frase} />
    <meta property="og:image" content={marca.logo} />
  </head>
  <body>
    <!-- ================= NAV ================= -->
    <header class="nav">
      <div class="wrap nav__inner">
        <a href="#inicio" class="nav__brand">
          <img src={marca.logo} alt={marca.nombreCompleto} class="nav__logo" />
          <span>{marca.nombreCompleto}</span>
        </a>
        <nav class="nav__links">
          <a href="#productos">Productos</a>
          <a href="#proceso">Cómo pedir</a>
          <a href="#galeria">Galería</a>
          <a href="#novedades">Novedades</a>
        </nav>
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="btn btn--azul nav__cta"
        >
          Pedir ahora
        </a>
      </div>
    </header>

    <!-- ================= HERO ================= -->
    <section id="inicio" class="hero">
      <div class="hero__blob" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <div class="hero__copy reveal">
          <span class="kicker">★ Sublimación · {marca.ubicacion}</span>
          <h1 class="hero__title">
            Tazas, agendas <br />y llaveros con
            <span class="mano hero__accent">tu propia historia</span>
          </h1>
          <p class="hero__lead">{marca.frase}</p>
          <div class="hero__btns">
            <a href={waLink} target="_blank" rel="noopener" class="btn">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path
                  d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.2.1.4.1.6-.1l.7-.9c.2-.2.3-.2.6-.1l2 .9c.3.2.5.2.5.4.1.1.1.8-.1 1.3Z"
                ></path></svg
              >
              Pedir por WhatsApp
            </a>
            <a href="#productos" class="btn btn--ghost">Ver productos →</a>
          </div>
          <div class="hero__sellos">
            <span>🤍 Hecho a mano</span>
            <span>🎨 100% personalizado</span>
            <span>📦 Listo para regalar</span>
          </div>
        </div>

        <div class="hero__collage reveal" style="animation-delay:.15s">
          <figure class="photo photo--1">
            <span
              class="tape"
              style="top:-14px; left:30px; transform:rotate(-6deg)"></span>
            <img
              src={galeria[0]}
              alt="Producto MM Sublimados"
              loading="eager"
            />
          </figure>
          <figure class="photo photo--2">
            <span
              class="tape"
              style="top:-12px; right:24px; transform:rotate(7deg)"></span>
            <img
              src={galeria[1]}
              alt="Producto MM Sublimados"
              loading="eager"
            />
          </figure>
          <div class="sticker sticker--pin">
            <img src={marca.logo} alt="" />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= MARQUEE ================= -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          Array.from({ length: 2 }).map(() => (
            <span>
              TAZAS&nbsp; ✷ &nbsp;AGENDAS&nbsp; ✷ &nbsp;LLAVEROS&nbsp; ✷
              &nbsp;PERSONALIZADO&nbsp; ✷ &nbsp;HECHO A MANO&nbsp; ✷ &nbsp;
            </span>
          ))
        }
      </div>
    </div>

    <!-- ================= PRODUCTOS ================= -->
    <section id="productos" class="seccion">
      <div class="wrap">
        <header class="seccion__head reveal">
          <span class="kicker kicker--azul">Lo que hacemos</span>
          <h2 class="seccion__title">
            Tres cosas, <span class="marca-rojo">mil maneras</span> de personalizarlas
          </h2>
        </header>

        <div class="cats">
          {
            categorias.map((c) => (
              <article class={`cat cat--${c.color} reveal`}>
                <span class="cat__tag mano">{c.etiqueta}</span>
                <h3 class="cat__title">{c.titulo}</h3>
                <p class="cat__desc">{c.descripcion}</p>
              </article>
            ))
          }
        </div>

        <!-- Filtros -->
        <!-- <div class="filtros reveal">
          <button class="chip is-active" data-filtro="todos">Todos</button>
          {
            categorias.map((c) => (
              <button class="chip" data-filtro={c.id}>
                {c.titulo}
              </button>
            ))
          }
        </div> -->

        <div class="wrap">
          <header class="seccion__head reveal">
            <span class="kicker kicker--azul">Hechos con cariño</span>
            <h2 class="seccion__title">
              El mural de <span class="marca-rojo">pedidos reales</span>
            </h2>
          </header>
          <div class="mural">
            {
              galeria.map((src, i) => (
                <figure
                  class={`mural__item reveal mural__item--${(i % 4) + 1}`}
                >
                  <span class="tape" />
                  <img
                    src={src}
                    alt="Trabajo de MM Sublimados"
                    loading="lazy"
                  />
                </figure>
              ))
            }
          </div>

          <!-- Testimonios sobre el mural -->
          <!-- <div class="testis">
          {testimonios.map((t) => (
            <blockquote class="testi reveal">
              <p class="testi__texto">“{t.texto}”</p>
              <cite class="testi__autor mano">— {t.autor}</cite>
            </blockquote>
          ))}
        </div> -->
        </div>

        <!-- Grilla -->
        <!-- <div class="grid " id="grid-productos">
        {productos.map((p, i) => (
          <article class="prod reveal" data-cat={p.categoria} style={`--i:${i}`}>
            <div class="prod__img">
              <span class="prod__badge mano">{p.etiqueta}</span>
              <img src={p.imagen} alt={p.titulo} loading="lazy" />
            </div>
            <div class="prod__body">
              <h3 class="prod__title">{p.titulo}</h3>
              <p class="prod__desc">{p.descripcion}</p>
              <a
                href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent('Hola MM, me interesa: ' + p.titulo)}`}
                target="_blank" rel="noopener" class="prod__link">
                Lo quiero →
              </a>
            </div>
          </article>
        ))}
      </div> -->
      </div>
    </section>

    <!-- ================= GALERIA (collage) ================= -->
    <!-- <section id="galeria" class="seccion">
    <div class="wrap">
      <header class="seccion__head reveal">
        <span class="kicker kicker--azul">Hechos con cariño</span>
        <h2 class="seccion__title">El mural de <span class="marca-rojo">pedidos reales</span></h2>
      </header>
      <div class="mural">
        {galeria.map((src, i) => (
          <figure class={`mural__item reveal mural__item--${(i % 4) + 1}`}>
            <span class="tape"></span>
            <img src={src} alt="Trabajo de MM Sublimados" loading="lazy" />
          </figure>
        ))}
      </div>

      <!-- Testimonios sobre el mural -->
    <!-- <div class="testis">
        {testimonios.map((t) => (
          <blockquote class="testi reveal">
            <p class="testi__texto">“{t.texto}”</p>
            <cite class="testi__autor mano">— {t.autor}</cite>
          </blockquote>
        ))}
      </div> -->
  </body>
</html> -->

<!-- ================= PROCESO ================= -->
<section id="proceso" class="proceso">
  <div class="wrap">
    <header class="seccion__head reveal">
      <span class="kicker">Sin complicaciones</span>
      <h2 class="seccion__title">
        Así de fácil es <span class="marca-azul">pedir el tuyo</span>
      </h2>
    </header>
    <ol class="pasos">
      {
        proceso.map((p) => (
          <li class="paso reveal">
            <span class="paso__num">{p.paso}</span>
            <h3 class="paso__title">{p.titulo}</h3>
            <p class="paso__texto">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ================= NOVEDADES / PUBLICACIONES ================= -->
<!-- <section id="novedades" class="novedades">
    <div class="wrap">
      <header class="seccion__head reveal">
        <span class="kicker">Lo último del taller</span>
        <h2 class="seccion__title">Novedades & <span class="marca-azul">temporadas</span></h2>
      </header>
      <div class="posts">
        {publicaciones.map((post) => (
          <a href={post.enlace} target="_blank" rel="noopener" class="post reveal">
            <div class="post__img"><img src={post.imagen} alt={post.titulo} loading="lazy" /></div>
            <div class="post__body">
              <span class="post__fecha">{post.fecha}</span>
              <h3 class="post__title">{post.titulo}</h3>
              <p class="post__texto">{post.texto}</p>
              <span class="post__link">Ver más ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section> -->

<!-- ================= CTA / CONTACTO ================= -->
<section id="contacto" class="cta">
  <div class="wrap cta__inner">
    <div class="cta__copy reveal">
      <span class="kicker kicker--claro">Empecemos</span>
      <h2 class="cta__title">
        ¿Tienes una idea <span class="mano cta__accent">en mente?</span>
      </h2>
      <p class="cta__lead">
        Escríbenos y la hacemos realidad. Respondemos rápido por WhatsApp.
      </p>
      <div class="cta__btns">
        <a href={waLink} target="_blank" rel="noopener" class="btn btn--azul"
          >Escribir por WhatsApp</a
        >
        <a href={mailLink} class="btn btn--ghost">Enviar correo</a>
      </div>
    </div>
    <div class="cta__datos reveal" style="animation-delay:.1s">
      <ul>
        <li>
          <span>WhatsApp</span><a href={waLink} target="_blank" rel="noopener"
            >{contacto.telefonoVisible}</a>
        </li>
        <li><span>Correo</span><a href={mailLink}>{contacto.correo}</a></li>
        <li><span>Horario</span><b>{contacto.horario}</b></li>
        <li>
          <span>Síguenos</span>
          <div class="cta__redes">
            <a href={redes.instagram} target="_blank" rel="noopener"
              >Instagram</a
            >
            <a href={redes.tiktok} target="_blank" rel="noopener">TikTok</a>
            <a href={redes.facebook} target="_blank" rel="noopener">Facebook</a>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="footer">
  <div class="wrap footer__inner">
    <a href="#inicio" class="footer__brand">
      <img src={marca.logo} alt="" />
      <span>{marca.nombreCompleto}</span>
    </a>
    <p class="footer__lema mano">{marca.lema}</p>
    <p class="footer__copy">
      © {year}
      {marca.nombreCompleto} · Sublimación hecha a mano
    </p>
  </div>
</footer>

<!-- WhatsApp flotante -->
<a
  href={waLink}
  target="_blank"
  rel="noopener"
  class="float-wa"
  aria-label="Escríbenos por WhatsApp"
>
  <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"
    ><path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.2.1.4.1.6-.1l.7-.9c.2-.2.3-.2.6-.1l2 .9c.3.2.5.2.5.4.1.1.1.8-.1 1.3Z"
    ></path></svg
  >
</a>

<style>
  /* ---------- NAV ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 235, 218, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 2.5px solid var(--tinta);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.25rem;
  }
  .nav__logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .nav__links {
    display: flex;
    gap: 1.6rem;
    font-weight: 600;
    font-size: 0.97rem;
  }
  .nav__links a {
    position: relative;
    padding: 2px 0;
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2.5px;
    background: var(--rojo);
    transition: width 0.25s ease;
  }
  .nav__links a:hover::after {
    width: 100%;
  }
  .nav__cta {
    padding: 0.55em 1.1em;
    font-size: 0.92rem;
    box-shadow: 3px 3px 0 var(--tinta);
  }
  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }
  .hero__blob {
    position: absolute;
    top: -16%;
    right: -12%;
    width: 56vw;
    height: 56vw;
    max-width: 720px;
    max-height: 720px;
    background:
      radial-gradient(circle at 40% 40%, var(--cinta-azul), transparent 62%),
      radial-gradient(circle at 65% 70%, var(--cinta-rojo), transparent 60%);
    filter: blur(8px);
    z-index: 0;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .kicker {
    display: inline-block;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rojo);
    margin-bottom: 1.1rem;
  }
  .kicker--azul {
    color: var(--azul-osc);
  }
  .kicker--claro {
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    margin-bottom: 1.3rem;
  }
  .hero__accent {
    display: inline-block;
    color: var(--rojo);
    font-size: 1.12em;
    transform: rotate(-2deg);
  }
  .hero__lead {
    font-size: clamp(1.02rem, 1.6vw, 1.22rem);
    max-width: 34ch;
    color: var(--tinta-soft);
    margin-bottom: 1.8rem;
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.6rem;
  }
  .hero__sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--tinta-soft);
  }

  .hero__collage {
    position: relative;
    min-height: 380px;
  }
  .photo {
    position: absolute;
    border: 3px solid var(--tinta);
    background: var(--papel);
    padding: 9px 9px 14px;
    box-shadow: var(--sombra-card);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo--1 {
    width: 62%;
    top: 0;
    left: 0;
    transform: rotate(-4deg);
    z-index: 2;
  }
  .photo--1 img {
    height: 280px;
  }
  .photo--2 {
    width: 54%;
    bottom: 0;
    right: 0;
    transform: rotate(5deg);
    z-index: 1;
  }
  .photo--2 img {
    height: 240px;
  }
  .sticker--pin {
    position: absolute;
    bottom: 8%;
    left: 8%;
    z-index: 3;
    width: 92px;
    height: 92px;
    background: var(--crema-soft);
    border: 3px solid var(--tinta);
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: var(--sombra-card);
    transform: rotate(-8deg);
  }
  .sticker--pin img {
    width: 64%;
  }
  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__collage {
      min-height: 340px;
      margin-top: 1rem;
    }
  }

  /* ---------- MARQUEE ---------- */
  .marquee {
    background: var(--rojo);
    color: var(--crema-soft);
    border-block: 3px solid var(--tinta);
    overflow: hidden;
    transform: rotate(-1.4deg) scale(1.04);
    margin: 1.5rem 0;
  }
  .marquee__track {
    display: flex;
    white-space: nowrap;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 0;
    animation: desliza 24s linear infinite;
  }
  @keyframes desliza {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- SECCIÓN base ---------- */
  .seccion {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }
  .seccion__head {
    margin-bottom: 2.6rem;
  }
  .seccion__title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    max-width: 18ch;
  }

  /* ---------- CATEGORÍAS ---------- */
  .cats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-bottom: 3rem;
  }
  .cat {
    padding: 1.8rem 1.6rem;
    border: 3px solid var(--tinta);
    background: var(--papel);
    box-shadow: var(--sombra-card);
    position: relative;
  }
  .cat--rojo {
    border-top: 10px solid var(--rojo);
  }
  .cat--azul {
    border-top: 10px solid var(--azul);
  }
  .cat__tag {
    position: absolute;
    top: -16px;
    right: 16px;
    background: var(--crema);
    border: 2.5px solid var(--tinta);
    padding: 0 0.6em;
    font-size: 1.15rem;
    transform: rotate(3deg);
  }
  .cat__title {
    font-size: 1.9rem;
    margin-bottom: 0.6rem;
  }
  .cat__desc {
    color: var(--tinta-soft);
    font-size: 0.98rem;
  }
  @media (max-width: 760px) {
    .cats {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FILTROS ---------- */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .chip {
    font-family: var(--cuerpo);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.5em 1.1em;
    border: 2.5px solid var(--tinta);
    background: var(--papel);
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .chip:hover {
    background: var(--cinta-azul);
  }
  .chip.is-active {
    background: var(--tinta);
    color: var(--crema-soft);
  }

  /* ---------- GRID PRODUCTOS ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  .prod {
    border: 3px solid var(--tinta);
    background: var(--papel);
    box-shadow: var(--sombra-card);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .prod:nth-child(3n) {
    transform: rotate(-0.8deg);
  }
  .prod:nth-child(3n + 2) {
    transform: rotate(0.8deg);
  }
  .prod:hover {
    transform: translateY(-6px) rotate(0);
    box-shadow: 9px 12px 0 rgba(30, 24, 20, 0.85);
  }
  .prod__img {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    border-bottom: 3px solid var(--tinta);
  }
  .prod__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prod__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--azul);
    color: var(--papel);
    border: 2.5px solid var(--tinta);
    padding: 0.1em 0.7em;
    font-size: 1.1rem;
    transform: rotate(-4deg);
